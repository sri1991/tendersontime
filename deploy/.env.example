# TenderScout AI — Environment Variables
# Copy this file to .env and fill in your values before deploying.
# The gcp_deploy.sh script will generate .env on the VM automatically.

# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...your_key_here

# ── Database (auto-generated secure password by deploy script) ─────────────────
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://tender:change_me_in_production@postgres:5432/tenderscout

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Search backend ────────────────────────────────────────────────────────────
# "postgres" = new pgvector backend (default)
# "chroma"   = legacy ChromaDB (use during migration only)
SEARCH_BACKEND=postgres

# ── ChromaDB (only needed when SEARCH_BACKEND=chroma) ────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ── Optional tuning ───────────────────────────────────────────────────────────
INTENT_CACHE_TTL_SECONDS=3600
