# Copy this to .env and fill in your values
# cp .env.example .env

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL
POSTGRES_USER=tenderscout
POSTGRES_PASSWORD=tenderscout
POSTGRES_DB=tenderscout
DATABASE_URL=postgresql+asyncpg://tenderscout:tenderscout@localhost:5432/tenderscout

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# Embedding model (Google text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Gemini model for Tier 2 enrichment
GEMINI_MODEL=gemini-2.0-flash-lite

# Pipeline settings
TIER0_CPV_CONFIDENCE_THRESHOLD=0.85
TIER2_BATCH_SIZE=10
MAX_DESCRIPTION_LENGTH=10000
MIN_DESCRIPTION_LENGTH=20
