# Copy to .env and fill in real values before running docker compose up
# cp .env.example .env

# ── Gemini API ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# These must match what docker-compose spins up
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tenderscout
# NOTE: inside Docker the host is "postgres" (service name), not localhost
DATABASE_URL=postgresql+asyncpg://tender:tender@postgres:5432/tenderscout

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── Pipeline settings ────────────────────────────────────────────────────────
TIER0_CPV_CONFIDENCE_THRESHOLD=0.85
TIER2_BATCH_SIZE=10
MAX_DESCRIPTION_LENGTH=10000
MIN_DESCRIPTION_LENGTH=20
